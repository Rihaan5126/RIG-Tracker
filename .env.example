# Local development. Copy to .env.local; never commit filled secrets.
APP_URL=http://127.0.0.1:3000
INSTAGRAM_PROVIDER=mock
PGLITE_PATH=.data/postgres
# Leave empty to use embedded PostgreSQL locally. Production requires both services.
DATABASE_URL=
REDIS_URL=
ALLOW_DEMO=true
ALLOW_REGISTRATION=true
TRUST_PROXY=false
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=
TOKEN_ENCRYPTION_KEY=
WORKER_TARGET=http://127.0.0.1:3000

# Instagram Login credentials (Instagram App ID/Secret, not your personal login).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Verify current Business Login documentation before setting these URLs.
# Expected allowlisted authorization endpoint: https://www.instagram.com/oauth/authorize
# Expected allowlisted token endpoint: https://api.instagram.com/oauth/access_token
META_AUTHORIZATION_URL=
META_TOKEN_URL=
# Choose the version explicitly supported by your reviewed Meta app, e.g. vNN.0.
META_API_VERSION=
META_SCOPES=instagram_business_basic,instagram_business_manage_insights
# Opt in only to fields verified for the selected version and permissions.
META_VERIFIED_PROFILE_FIELDS=
META_VERIFIED_MEDIA_FIELDS=
META_VERIFIED_INSIGHT_METRICS=
